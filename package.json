    "jszip": "^3.10.1",
    "lucide-preact": "^1.38.0",
    "preact": "^10.29.1",
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
